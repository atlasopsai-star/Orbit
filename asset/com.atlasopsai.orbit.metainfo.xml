<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.atlasopsai.orbit</id>

  <name>Orbit</name>
  <summary>Pretty fancy and modern terminal file manager</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <description>
    <p>
      Orbit is a fast, beautiful, keyboard-first terminal file manager built with Go and Bubble Tea.
      It combines a polished, multi-panel interface with the speed and power of terminal tools,
      making it easy to browse, preview, and manage files without leaving the command line.
    </p>
  </description>

  <url type="homepage">https://github.com/atlasopsai-star/Orbit</url>
  <url type="bugtracker">https://github.com/atlasopsai-star/Orbit/issues</url>
  <url type="vcs-browser">https://github.com/atlasopsai-star/Orbit</url>

  <developer id="com.atlasopsai">
    <name>Atlas Ops AI</name>
  </developer>

  <launchable type="desktop-id">orbit.desktop</launchable>

  <provides>
    <binary>orbit</binary>
  </provides>

  <categories>
    <category>System</category>
    <category>FileManager</category>
  </categories>

  <keywords>
    <keyword>file</keyword>
    <keyword>manager</keyword>
    <keyword>terminal</keyword>
    <keyword>explorer</keyword>
  </keywords>

  <content_rating type="oars-1.1" />

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/atlasopsai-star/Orbit/main/website/src/assets/demo.png</image>
      <caption>Orbit terminal file manager</caption>
    </screenshot>
  </screenshots>
</component>
